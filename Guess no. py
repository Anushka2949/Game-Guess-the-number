import random

num = random.randint(1, 10)
tries = 0

while tries < 7:
    guess = int(input("enter no. "))
    tries += 1
    if guess > num:
        print("too high")
    elif guess < num:
        print("too low")
    else:
        print("correct, tries =", tries)
        break
else:
    print("You lose! The number was", num)
